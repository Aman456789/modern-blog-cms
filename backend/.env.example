# Server Setup
PORT=8080
NODE_ENV=production
FRONTEND_URL=https://your-production-frontend-domain.com
CLIENT_URL=https://your-production-frontend-domain.com

# Database & Auth
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/fotographiya_blog?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
CRON_SECRET=your_cron_secret_key_here

# AWS S3 Storage
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=blog-media-bucket-888
